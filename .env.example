NODE_ENV=development
# Blank optional values are treated as absent; surrounding whitespace is invalid.
# MONGODB_URI must use mongodb:// or mongodb+srv:// and is syntax-checked only.
MONGODB_URI=
OPENAI_API_KEY=
LEDGER_WORKSPACE_ID=demo
# Remote commands require explicit test-only database and namespace values.
MONGODB_TEST_DATABASE=
MONGODB_TEST_NAMESPACE=
MONGODB_TIMEOUT_MS=5000
